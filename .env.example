NODE_ENV=production
PORT=3000

# Writable folder for leads.json / app-settings.json. If set, this path is always used (recommended for production).
# Set on the server so lead data survives redeploys (same path every release).
# LEADS_DATA_DIR=/home/youruser/uniq-data

# Force non-Secure admin cookies in production (only if you must use HTTP without a reverse proxy).
# ADMIN_COOKIE_INSECURE=true
# Set to true only if you must embed the prod site in an iframe (weakens clickjacking protection).
# ALLOW_EMBEDDED_PREVIEW=

# Admin UI is at /infozub-admin (legacy /admin and /infozunb-admin redirect there). API remains /api/admin/*.
# Set ADMIN_PASSWORD on the server (use .env.local locally — never commit real passwords).
# ADMIN_PASSWORD=
# Optional: 32+ random chars to sign sessions (otherwise derived from the password).
# ADMIN_SESSION_SECRET=
# Optional session lifetime in seconds (default 28800 = 8h, max 604800).
# ADMIN_SESSION_MAX_SECONDS=28800

# --- Google Tag Manager ---
# When set (format GTM-XXXXXXX), the container loads site-wide.
# NEXT_PUBLIC_GTM_ID=

# --- Public lead form ---
# Cloudflare Turnstile: both required together for enforcement.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Max submissions per IP per minute (default 8).
# LEAD_RATE_LIMIT_PER_MINUTE=8

# --- Google Sheets (env wins over admin UI file — set these on production for stable sync after deploy) ---
# Primary names (recommended):
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=   (use \n for newlines inside the PEM, or paste JSON via GOOGLE_SERVICE_ACCOUNT_JSON)
# GOOGLE_SHEETS_TAB=Sheet1
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternate names (also supported):
# GOOGLE_SHEET_ID=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# Optional (not required for Sheets API; documentation / future use):
# GOOGLE_PROJECT_ID=

# --- Optional SMTP backup ---
# EMAIL_USER=
# EMAIL_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_TO=
