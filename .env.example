NODE_ENV=production
PORT=3000

# Writable folder for leads.json and app-settings.json (absolute path recommended on Hostinger).
# LEADS_DATA_DIR=/home/youruser/uniq-data
# Set to true only if you must embed the prod site in an iframe (weakens clickjacking protection).
# ALLOW_EMBEDDED_PREVIEW=

# --- Admin ---
# If unset, login password defaults to admin123. Set a strong value on Hostinger.
# ADMIN_PASSWORD=
# Optional: 32+ random chars to sign sessions (otherwise derived from the password).
# ADMIN_SESSION_SECRET=
# Optional session lifetime in seconds (default 28800 = 8h, max 604800).
# ADMIN_SESSION_MAX_SECONDS=28800

# --- Public lead form ---
# Cloudflare Turnstile: both required together for enforcement.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Max submissions per IP per minute (default 8).
# LEAD_RATE_LIMIT_PER_MINUTE=8

# --- Google Sheets (optional: use /admin form — saves to data/app-settings.json) ---
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEETS_TAB=Sheet1
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Optional SMTP backup ---
# EMAIL_USER=
# EMAIL_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_TO=
